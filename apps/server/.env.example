# Server
NODE_ENV=development
PORT=3001
API_ORIGIN=http://localhost:3001
TRUSTED_ORIGIN=http://localhost:3000

# Optional: enables cross-instance real-time board event fan-out
# REDIS_URL=redis://localhost:6379

# API protection (set TRUST_PROXY=true only behind a trusted reverse proxy)
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

# WebSocket lifecycle and capacity limits
WS_HEARTBEAT_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=90000
WS_MAX_CONNECTIONS_PER_BOARD=500
WS_MAX_CONNECTIONS_PER_USER=5

# Database (shared with @orbit/db)
DATABASE_URL=postgres://user:password@localhost:5432/orbit

# better-auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
